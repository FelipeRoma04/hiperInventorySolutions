<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    
    <display-name>HiperInventory Solutions</display-name>
    <description>Sistema de Gestión de Inventario</description>
    
    <!-- Listeners -->
    <listener>
        <listener-class>com.hiper.inventory.servlets.AppInitListener</listener-class>
    </listener>
    
    <!-- Auth Servlet -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.hiper.inventory.servlets.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/api/auth/*</url-pattern>
    </servlet-mapping>
    
    <!-- Asset Servlet -->
    <servlet>
        <servlet-name>AssetServlet</servlet-name>
        <servlet-class>com.hiper.inventory.servlets.AssetServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AssetServlet</servlet-name>
        <url-pattern>/api/assets/*</url-pattern>
    </servlet-mapping>
    
    <!-- Maintenance Servlet (Fase 3) -->
    <servlet>
        <servlet-name>MaintenanceServlet</servlet-name>
        <servlet-class>com.hiper.inventory.servlets.MaintenanceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MaintenanceServlet</servlet-name>
        <url-pattern>/api/maintenance/*</url-pattern>
    </servlet-mapping>
    
    <!-- Depreciation Servlet (Fase 3) -->
    <servlet>
        <servlet-name>DepreciationServlet</servlet-name>
        <servlet-class>com.hiper.inventory.servlets.DepreciationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DepreciationServlet</servlet-name>
        <url-pattern>/api/depreciation/*</url-pattern>
    </servlet-mapping>
    
    <!-- Import Servlet (Fase 3) -->
    <servlet>
        <servlet-name>ImportServlet</servlet-name>
        <servlet-class>com.hiper.inventory.servlets.ImportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ImportServlet</servlet-name>
        <url-pattern>/api/import/*</url-pattern>
    </servlet-mapping>
    
    <!-- API External Servlet (Fase 3) -->
    <servlet>
        <servlet-name>ApiExternalServlet</servlet-name>
        <servlet-class>com.hiper.inventory.servlets.ApiExternalServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiExternalServlet</servlet-name>
        <url-pattern>/api/external/*</url-pattern>
    </servlet-mapping>
    
    <!-- Report Servlet -->
    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>com.hiper.inventory.servlets.ReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/api/reports/*</url-pattern>
    </servlet-mapping>
    
    <!-- User Servlet -->
    <servlet>
        <servlet-name>UserServlet</servlet-name>
        <servlet-class>com.hiper.inventory.servlets.UserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/api/users/*</url-pattern>
    </servlet-mapping>

    <!-- Audit Servlet -->
    <servlet>
        <servlet-name>AuditServlet</servlet-name>
        <servlet-class>com.hiper.inventory.servlets.AuditServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuditServlet</servlet-name>
        <url-pattern>/api/audit/*</url-pattern>
    </servlet-mapping>

    <!-- Categoria Servlet -->
    <servlet>
        <servlet-name>CategoriaServlet</servlet-name>
        <servlet-class>com.hiper.inventory.servlets.CategoriaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CategoriaServlet</servlet-name>
        <url-pattern>/api/categorias/*</url-pattern>
    </servlet-mapping>

    <!-- Ubicacion Servlet -->
    <servlet>
        <servlet-name>UbicacionServlet</servlet-name>
        <servlet-class>com.hiper.inventory.servlets.UbicacionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UbicacionServlet</servlet-name>
        <url-pattern>/api/ubicaciones/*</url-pattern>
    </servlet-mapping>

    <!-- Performance Servlet (Fase 4) -->
    <servlet>
        <servlet-name>PerformanceServlet</servlet-name>
        <servlet-class>com.hiper.inventory.servlets.PerformanceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PerformanceServlet</servlet-name>
        <url-pattern>/api/performance/*</url-pattern>
    </servlet-mapping>
    
    <!-- Welcome Files -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>inicio.jsp</welcome-file>
        <welcome-file>dashboard.jsp</welcome-file>
    </welcome-file-list>
    
    <!-- Error Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/error-404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error-500.jsp</location>
    </error-page>
    
</web-app>
